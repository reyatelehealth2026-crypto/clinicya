      "from_module": "LineAccountManager",
      "to_module": "Mini App / LINE APIs",
      "returns_what": "LINE account credentials",
      "why_needed": "feature ฝั่ง LINE ต้อง scope ด้วย line_account_id"
    }
  ],
  "gotchas": [
    "root domain ต้องไม่ pin tenant-0001 เมื่อ request มี account routing signal",
    "pending_setup ไม่ได้ lock ระบบทั้งหมด แต่เข้า DEMO mode",
    "tenant template เคยขาด admin_users จึงมี ensureAdminUsersTable เป็น safety net",
    "super-admin ไม่มี implicit tenant; ต้อง setCurrentTenantId หรือ enterPlatformContext"
  ],
