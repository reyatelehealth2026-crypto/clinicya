      "why_needed": "ทุก Database::getInstance() หลังจากนั้นต้องรู้ tenant ที่ถูกต้อง"
    },
    {
      "from_module": "TenantProvisioning",
      "to_module": "TenantOnboardingService",
      "returns_what": "db_name",
