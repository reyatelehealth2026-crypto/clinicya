+                'contents' => [
+                    ['type' => 'text', 'text' => "สวัสดีค่ะ คุณ{$name}", 'weight' => 'bold', 'size' => 'md'],
+                    ['type' => 'text', 'text' => 'เราได้รับการจองของคุณแล้ว ระบบจะแจ้งเตือนอีกครั้งก่อนถึงเวลานัด', 'size' => 'sm', 'color' => '#666666', 'wrap' => true],
