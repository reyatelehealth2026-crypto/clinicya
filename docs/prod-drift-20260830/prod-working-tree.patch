+            .then(j => {
+                if (j.ok) {
+                    if (j.soft) {
+                        alert('สินค้านี้มีประวัติการใช้งาน — ปิดการขายแทนการลบ (ข้อมูลยังอยู่)');
+                    }
+                    location.reload();
+                } else {
+                    alert('ลบไม่สำเร็จ: ' + (j.message || j.error || 'unknown'));
+                }
+            })
+            .catch(e => alert('เครือข่าย: ' + e.message));
+    }
