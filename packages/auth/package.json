{
  "name": "@reya/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Two-realm (tenant/platform) stateful session kernel + PHP session-bridge client — TypeScript port of classes/AdminAuth.php, admin/platform-login.php, admin/switch-tenant.php.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reya/config": "workspace:*",
    "@reya/db": "workspace:*",
    "bcryptjs": "^2.4.3",
    "ioredis": "^5.3.2",
    "kysely": "^0.29.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
