{
  "name": "@reya/config",
  "version": "0.1.0",
  "private": true,
  "description": "Zod-validated environment schema + platform constants shared by the Next.js migration kernel packages.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
