# LINE CRM - Apache Configuration for re-ya.com
# Clean URLs without .php extension

# Enable RewriteEngine
RewriteEngine On

# Base path - root domain (re-ya.com)
RewriteBase /

# =====================================================
# SECURITY: block ad-hoc / one-off debug & data-fix scripts at web root.
# Root-anchored (^ matches the path from the document root), so this only
# forbids files named with these prefixes DIRECTLY under the web root —
# api/sync_*.php, cron/check_*.php, install/check_*.php etc. are NOT matched
# because their path starts with "api/", "cron/", "install/". These scripts
# have no auth guard of their own and were relocated to /scripts/adhoc/
# (see issue #13); this rule is defense-in-depth against future strays.
# =====================================================
RewriteRule ^(check_|debug_|fix_|final_|sync_|get_|verify_)[^/]*\.php$ - [F,L]

# =====================================================
# SEO Files - Dynamic sitemap.xml and robots.txt
# Requirements: 9.1, 9.2, 9.3, 9.4, 9.5
# =====================================================
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# =====================================================
# LIFF entry points → NEW Mini App (/miniapp/, Next.js static export)
# 2026-06-02: was redirecting to the retired /liff/ SPA. QSA preserves the
# LIFF `liff.state` query (e.g. ?liff.state=/claim?token=...) so deep links
# route correctly inside the Mini App. 302 (not 301) so clients don't cache
# the mapping while channels are migrated to the /miniapp/ endpoint.
# =====================================================
RewriteRule ^liff-app\.php$ /miniapp/ [R=302,L,QSA]
RewriteRule ^liff-appointment\.php$ /miniapp/appointments/ [R=302,L,QSA]
RewriteRule ^liff-my-appointments\.php$ /miniapp/appointments/ [R=302,L,QSA]
RewriteRule ^liff-checkout\.php$ /miniapp/cart/ [R=302,L,QSA]
RewriteRule ^liff-member-card\.php$ /miniapp/profile/ [R=302,L,QSA]
RewriteRule ^liff-settings\.php$ /miniapp/profile/ [R=302,L,QSA]
RewriteRule ^liff-my-orders\.php$ /miniapp/orders/ [R=302,L,QSA]
RewriteRule ^liff-order-detail\.php$ /miniapp/orders/ [R=302,L,QSA]
RewriteRule ^liff-pharmacy-consult\.php$ /miniapp/ai-chat/ [R=302,L,QSA]
RewriteRule ^liff-symptom-assessment\.php$ /miniapp/ai-chat/ [R=302,L,QSA]
RewriteRule ^liff-points-history\.php$ /miniapp/rewards/history/ [R=302,L,QSA]
RewriteRule ^liff-points-rules\.php$ /miniapp/rewards/ [R=302,L,QSA]
RewriteRule ^liff-redeem-points\.php$ /miniapp/rewards/ [R=302,L,QSA]
RewriteRule ^liff-product-detail\.php$ /miniapp/shop/ [R=302,L,QSA]
RewriteRule ^liff-promotions\.php$ /miniapp/shop/ [R=302,L,QSA]
RewriteRule ^liff-shop\.php$ /miniapp/shop/ [R=302,L,QSA]
RewriteRule ^liff-shop-v3\.php$ /miniapp/shop/ [R=302,L,QSA]
RewriteRule ^liff-register\.php$ /miniapp/register/ [R=302,L,QSA]
RewriteRule ^liff-video-call\.php$ /miniapp/video/ [R=302,L,QSA]
RewriteRule ^liff-video-call-pro\.php$ /miniapp/video/ [R=302,L,QSA]
RewriteRule ^liff-wishlist\.php$ /miniapp/wishlist/ [R=302,L,QSA]
RewriteRule ^liff-consent\.php$ /miniapp/ [R=302,L,QSA]
RewriteRule ^liff-main\.php$ /miniapp/ [R=302,L,QSA]
# Share keeps its dedicated LIFF (no Mini App equivalent yet)
RewriteRule ^liff-share\.php$ /liff/index.php?page=share [R=302,L,QSA]

# =====================================================
# Clean URLs - ไม่ต้องพิมพ์ .php
# เช่น /broadcast แทน /broadcast.php
# =====================================================

# ถ้าไม่ใช่ไฟล์หรือโฟลเดอร์จริง ให้ลองหา .php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]

# รองรับ subdirectory เช่น /shop/products, /api/checkout
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/([^/]+)/?$ $1/$2.php [L]

# รองรับ 3 levels เช่น /api/shop/products
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/([^/]+)/([^/]+)/?$ $1/$2/$3.php [L]

# =====================================================

# Set default charset
AddDefaultCharset UTF-8

# Disable directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect config files
<FilesMatch "config\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect lock file
<FilesMatch "installed\.lock$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# PHP Settings (for mod_php)
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
    php_value upload_max_filesize 50M
    php_value post_max_size 50M
    php_value max_execution_time 300
    php_value memory_limit 256M
    php_value date.timezone "Asia/Bangkok"
    php_value default_charset "UTF-8"
    php_value mbstring.internal_encoding "UTF-8"
</IfModule>

# PHP Settings (for PHP-FPM / FastCGI)
<IfModule mod_fcgid.c>
    FcgidInitialEnv PHP_FCGI_CHILDREN 0
</IfModule>

# Compress files
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Cache static files
<IfModule mod_expires.c>
    ExpiresActive on
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
</IfModule>
