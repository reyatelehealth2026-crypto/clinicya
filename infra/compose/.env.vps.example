# infra/compose/.env.vps.example
#
# Environment for the standalone VPS trial stack
# (infra/compose/docker-compose.vps.yml). Copy, then fill in real values:
#
#   cp infra/compose/.env.vps.example infra/compose/.env.vps
#   chmod 600 infra/compose/.env.vps
#
# NEVER commit infra/compose/.env.vps — `.env` and `.env.*.local` are
# gitignored, but `.env.vps` is NOT matched by those patterns. Keep it out of
# git yourself, or add it to .gitignore before creating it. GitGuardian scans
# this repository.
#
# Vars marked REQUIRED have no default; compose refuses to start without them
# (the `:?` syntax in the compose file) rather than silently booting with an
# empty credential.

# --- Database (REQUIRED) --------------------------------------------------
# Use fresh, strong values. Do NOT reuse the cPanel production password: this
# stack is reachable from a public IP during the trial.
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

# Defaults below match config/config.php's hardcoded DB_NAME/DB_USER so the
# unmodified PHP authenticates without a code change. Only override if you
# also change config.php.
#MARIADB_DATABASE=zrismpsz_clinicya
#MARIADB_USER=zrismpsz_clinicya

# --- Session bridge (REQUIRED) --------------------------------------------
# Shared HMAC-SHA256 secret between @reya/auth's bridgeClient and
# internal/session-bridge.php. Generate one:
#   openssl rand -hex 32
SESSION_BRIDGE_HMAC_SECRET=

# --- Tenant routing -------------------------------------------------------
#REYA_BASE_DOMAIN=re-ya.com
# Tenant slug the bare root domain maps to. Empty = disabled.
#REYA_ROOT_TENANT_SLUG=

# --- Ports ----------------------------------------------------------------
# Edge listen port on the host. Use 8091 instead of 80 if something else on
# the VPS already owns 80.
#EDGE_HTTP_PORT=80

# --- Next.js build-time vars ----------------------------------------------
# Inlined into the CLIENT bundle at build time — changing this requires
# `docker compose ... build next-admin`, not just a restart. Leave empty for
# the trial unless you have a public realtime URL.
#NEXT_PUBLIC_REALTIME_URL=

# --- Misc -----------------------------------------------------------------
#REDIS_SESSION_DB=1
#NODE_SESSION_TTL_SECONDS=86400
