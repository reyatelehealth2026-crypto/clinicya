# Phase 0 strangler overlay — required secrets (docker-compose.strangler.yml)
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — ห้าม commit ไฟล์ .env (ถูก gitignore แล้ว)
# Copy to .env and fill in real values. Never commit the .env file.
#
# Usage:
#   cp infra/compose/.env.example infra/compose/.env
#   docker compose --env-file infra/compose/.env \
#     -f docker-compose.dev.yml -f infra/compose/docker-compose.strangler.yml up
#
# Dev container: set MARIADB_PASSWORD to the DB_PASS value in your local
# config/config.php. Production (real Phase 0): use strong unique passwords
# and rotate any credential that was ever committed or shared.

MARIADB_ROOT_PASSWORD=change-me-strong-root-password
MARIADB_PASSWORD=change-me-app-db-password

# Optional overrides (names default to the repo's config.php values)
#MARIADB_DATABASE=zrismpsz_clinicya
#MARIADB_USER=zrismpsz_clinicya
#REDIS_SESSION_DB=1

# Phase 4 batch 2 (mig-infra plumbing brief): infra/compose/docker-compose.worker.yml
# publishes apps/worker's realtime Socket.io server to the host on this port
# (defaults to 8100 if unset — matches apps/worker/src/env.ts's
# DEFAULT_WORKER_REALTIME_PORT / WORKER_REALTIME_PORT). Only override this if
# 8100 is already taken on your host.
#WORKER_REALTIME_HOST_PORT=8100
#
# apps/admin isn't part of this compose stack (no container yet — it's run on
# the host via `next dev`), so it does NOT read this file. When running
# apps/admin locally against a docker-composed worker, set in apps/admin's OWN
# .env.local:
#   NEXT_PUBLIC_REALTIME_URL=http://localhost:8100
# (matching whatever WORKER_REALTIME_HOST_PORT above resolves to).
