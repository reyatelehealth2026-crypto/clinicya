-- infra/e2e/seed/20-admin-user.sql.tmpl
--
-- SEQUENCING TRAP (see docs/plans/2026-07-12-nextjs-full-migration-plan.md
-- and this harness's run.mjs comments): `admin_users` does NOT exist in the
-- bare tenant template (database/migration_2026-05-25_tenant_template.sql
-- deliberately excludes it — platform-level tables live elsewhere). It is
-- only auto-created by classes/AdminAuth.php's constructor fallback
-- (CLAUDE.md's "Auto-create tables" gotcha), which only runs when
-- includes/auth_check.php instantiates `new AdminAuth($db)` on a real page
-- load. So run.mjs fires ONE throwaway unauthenticated GET at the probe
-- page FIRST — that creates `admin_users` (+ admin_bot_access +
-- admin_activity_log) with the exact schema PHP itself expects, including a
-- default seeded 'admin' row (password 'password') that this harness does
-- NOT rely on — before this file ever runs.
--
-- __ADMIN_USERNAME__ / __ADMIN_PASSWORD_HASH__ are substituted by run.mjs.
-- The hash is a REAL PHP bcrypt hash, generated by invoking
-- `password_hash($plain, PASSWORD_DEFAULT)` inside the harness's own `php`
-- container (php:8.2-apache, same runtime as production) — not bcryptjs,
-- not hand-written — so the login() call in step 2 genuinely exercises
-- packages/auth/src/passwords.ts's verifyLegacyPassword() cross-runtime
-- claim (bcryptjs verifying a real PHP `$2y$` hash), the same way that
-- package's own test fixture does.
--
-- DELETE-then-INSERT (not INSERT ... ON DUPLICATE KEY UPDATE) so a re-run
-- against a lingering row always ends up with the freshly-generated hash
-- for this run, never a stale one from an earlier run.

DELETE FROM `admin_users` WHERE `username` = '__ADMIN_USERNAME__';

INSERT INTO `admin_users` (`username`, `password`, `email`, `display_name`, `role`, `is_active`)
VALUES (
  '__ADMIN_USERNAME__',
  '__ADMIN_PASSWORD_HASH__',
  'e2e-bridge-harness@example.invalid',
  'E2E Bridge Harness Admin',
  'super_admin',
  1
);
