# Copy to `.env.local` for local development. Set values per environment in Vercel/hosting dashboard.

# FALLBACK base URL of the PHP backend (no trailing slash). Only used when the
# mini app is NOT served from a tenant subdomain (local dev / root domain).
#
# SaaS subdomain separation: in production the mini app is served per tenant at
# https://tenant-XXXX.re-ya.com/miniapp/ and `src/lib/config.ts` automatically
# calls the PHP API on that SAME origin, so resolve_subdomain.php pins the
# correct tenant DB. Register each OA's LIFF Endpoint URL on its own tenant
# subdomain so customers land on the right database instead of the legacy default.
NEXT_PUBLIC_PHP_API_BASE_URL=https://cny.re-ya.com

# Root SaaS domain that tenant subdomains hang off of. Override only if the base
# domain differs from re-ya.com (must match REYA_BASE_DOMAIN on the PHP side).
NEXT_PUBLIC_REYA_BASE_DOMAIN=re-ya.com

# LINE LIFF ID for this mini app (LINE Developers → LIFF app). Must match the **Endpoint URL**
# you register for the LIFF app (e.g. Next deploy URL), not `liff/index.php`, unless that is your chosen entry.
NEXT_PUBLIC_LINE_LIFF_ID=

# LINE Login channel ID (optional; used if UI needs it)
NEXT_PUBLIC_LINE_CHANNEL_ID=

# `line_accounts.id` WITHIN the resolved tenant DB — scopes shop/member APIs to
# the correct OA. With subdomain separation the tenant DB is chosen by the host,
# so this only needs to disambiguate multiple OAs inside a single tenant (1 by default).
NEXT_PUBLIC_LINE_ACCOUNT_ID=1

# Display name in `<title>` / metadata
NEXT_PUBLIC_MINIAPP_NAME=Re-Ya LINE Mini App
