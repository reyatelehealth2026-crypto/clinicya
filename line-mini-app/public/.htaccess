# Mini App cache policy (/miniapp/.htaccess).
# Next.js static export hashes JS/CSS filenames per build -> cache those forever.
# HTML entry pages must always revalidate, else the LINE LIFF in-app browser keeps
# serving a stale bundle after a deploy (caused "Invalid LIFF ID" on banyarimchol).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|png|jpe?g|svg|webp|gif|ico|json)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
